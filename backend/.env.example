# Used when running the backend outside Docker (npm run dev).
# Docker Compose sets these from the root .env instead.
PORT=4000
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=lomakeavustin
DB_PASSWORD=lomakeavustin
DB_NAME=lomakeavustin

# Login sessions. COOKIE_SECURE must be true when served over HTTPS; keep false for http://localhost.
SESSION_TTL_HOURS=24
COOKIE_SECURE=false
