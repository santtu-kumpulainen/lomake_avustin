# Copy to .env. Simple dev credentials; change them before any real use. Never commit .env.
# Synthetic development data only.

MARIADB_ROOT_PASSWORD=<MARIADB_ROOT_PASSWORD>
MARIADB_DATABASE=lomakeavustin
MARIADB_USER=lomakeavustin
MARIADB_PASSWORD=<MARIADB_PASSWORD>

# Host ports. MariaDB defaults to 3307 to avoid clashing with a local 3306.
FRONTEND_PORT=3000
BACKEND_PORT=4000
MARIADB_HOST_PORT=3307
